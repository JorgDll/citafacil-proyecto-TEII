# Copia este archivo a .env y ajusta los valores.  (cp .env.example .env)

# --- Base de datos ---
# Local: SQLite.  Producción: PostgreSQL (ej: postgresql://user:pass@host:5432/db)
DATABASE_URL=sqlite:///./citafacil.db

# --- Seguridad ---
# Clave de instalación del panel (HU-6): solo sirve para crear al primer propietario;
# después ya no abre nada. ¡CÁMBIALA por una propia! Con el valor por defecto el panel
# se niega a crear al propietario.
ADMIN_TOKEN=cambia-este-token-admin

# Dominios permitidos para el frontend (separados por coma). * = todos.
CORS_ORIGINS=*

# --- Cuentas del panel admin (HU-6) ---
# ADMIN_TOKEN ya no abre la API: solo sirve de clave de instalación para crear al
# primer propietario desde el panel. Cámbialo por uno propio (el valor por defecto
# de abajo se rechaza).
SESSION_HOURS=12
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
PASSWORD_MIN_LENGTH=10

# --- Autogestión de la cita (HU-5) ---
# URL con la que el cliente abre la app: base del enlace de WhatsApp. En local el
# enlace no abre desde un teléfono; usa la IP de tu red, un túnel o tu dominio.
PUBLIC_BASE_URL=http://localhost:8000
# Horas mínimas de anticipación para cancelar o reprogramar desde el enlace
MANAGE_CUTOFF_HOURS=2
# Cuántas veces puede reprogramar una misma cita
MANAGE_MAX_RESCHEDULES=2

# --- Dispositivo recordado (HU-1) ---
DEVICE_COOKIE_NAME=citafacil_device
DEVICE_COOKIE_DAYS=365
# true solo si sirves la app por HTTPS (la cookie se marca Secure)
COOKIE_SECURE=false

# --- Negocio ---
BUSINESS_NAME=Barbería Don Lucho
# País base (ISO 3166-1 alpha-2): interpreta números escritos sin '+' y es el país
# preseleccionado en el selector de teléfono. Ej: PA, CL, US.
DEFAULT_COUNTRY=PA
BUSINESS_TIMEZONE=America/Santiago
CURRENCY=CLP
OPEN_HOUR=10
CLOSE_HOUR=20
SLOT_INTERVAL_MINUTES=30
# Días cerrados (0=lunes ... 6=domingo). Ej "6" cierra domingo; "5,6" cierra fin de semana.
CLOSED_WEEKDAYS=6

# --- Twilio / WhatsApp ---
# Déjalos vacíos para MODO DEMO (los mensajes se registran en el log, no se envían).
# Complétalos para enviar WhatsApp reales.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
# Número de WhatsApp de Twilio (el sandbox de pruebas es whatsapp:+14155238886)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# Cuántas horas antes se envía el recordatorio, y cada cuánto revisa el sistema.
REMINDER_HOURS_BEFORE=24
REMINDER_POLL_MINUTES=15
